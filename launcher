<script>
const SITE_URL = "https://fuzzby101.github.io/project1/";
const SOURCE_URL = "https://raw.githubusercontent.com/Fuzzby101/project1/refs/heads/main/index.html";
const PROJECT_KEY = "project1_autolaunch";
const projectBtn = document.getElementById("project");
const projectToggle = document.getElementById("projectToggle");
const labelProject = document.getElementById("labelProject");
function getEnabled(key, fallback) {
    const v = localStorage.getItem(key);
    return v === null ? fallback : v === "true";
}
function setEnabled(key, value) {
    localStorage.setItem(key, value);
}
function applyUI() {
    const enabled = getEnabled(PROJECT_KEY, false);
    projectToggle.checked = enabled;
    labelProject.classList.toggle("active", enabled);
    projectBtn.classList.toggle("default", enabled);
}
projectToggle.addEventListener("change", () => {
    setEnabled(PROJECT_KEY, projectToggle.checked);
    applyUI();
    flashSaved(labelProject);
});
function flashSaved(labelEl) {
    const original = "Cyanide";
    labelEl.textContent = "Saved";
    setTimeout(() => {
        labelEl.textContent = original;
    }, 900);
}
async function launch() {
    const win = window.open("about:blank", "_blank");
    if (!win) {
        alert("Pop-up blocked. Allow pop-ups and try again.");
        return;
    }
    try {
        const response = await fetch(SOURCE_URL + "?v=" + Date.now());
        if (!response.ok) {
            throw Error("HTTP " + response.status);
        }
        let code = await response.text();
        code = code.replace(
            /<head([^>]*)>/i,
            `<head$1><base href="${SITE_URL}">`
        );
        win.document.open();
        win.document.write(code);
        win.document.close();
        win.document.title = "Cyanide";
    } catch (error) {
        win.close();
        alert("Could not load Cyanide: " + error.message);
    }
}
projectBtn.onclick = launch;
applyUI();
window.onload = () => {
    if (getEnabled(PROJECT_KEY, false)) {
        launch();
    }
};
</script>